# Instance secrets. Copy this file to .env (gitignored) and fill in only
# the values your installed plugins actually need — most secrets here can
# also be set via `claude plugin install <name> --config KEY=VALUE`
# instead (see each plugin's README for its userConfig options); use
# whichever you prefer, both are read.
#
# This file intentionally ships empty. Uncomment/fill in only what applies
# to the plugins you've installed.

# --- concierge-memory-obsidian ---
# OBSIDIAN_API_KEY=
# OBSIDIAN_HOST=127.0.0.1
# OBSIDIAN_PORT=27124

# --- concierge-google ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- concierge-fantasy ---
# SLEEPER_USER_ID=
# SLEEPER_LEAGUE_IDS=
# ESPN_S2=
# ESPN_SWID=
# ESPN_LEAGUE_ID=
# ESPN_LEAGUE_NAME=
# ESPN_TEAM_ID=
# ESPN_SEASON_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_FFB_CHANNEL_ID=

# --- concierge-paperwork ---
# PAPERWORK_SOURCE_DIR=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# PAPERWORK_SP_SITE_ID=

# --- concierge-media ---
# credentials referenced by name in config/media.json — see that plugin's
# README for the exact env var names it expects
